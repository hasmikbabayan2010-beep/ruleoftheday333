<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#880E4F"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your rule shapes your day 🌷"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:textStyle="italic"
                android:textColor="#F48FB1"
                android:layout_marginBottom="20dp"/>

            <!-- Goal & Habit Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯  Your Goal"
                        android:textSize="12sp"
                        android:textColor="#F48FB1"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/goalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. get fit, read more, drink water"
                        android:padding="12dp"
                        android:background="@drawable/input_bg"
                        android:textColor="#5D4037"
                        android:textColorHint="#BDBDBD"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💤  Your Current Habit"
                        android:textSize="12sp"
                        android:textColor="#F48FB1"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/habitInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. lazy, scrolling too much"
                        android:padding="12dp"
                        android:background="@drawable/input_bg"
                        android:textColor="#5D4037"
                        android:textColorHint="#BDBDBD"
                        android:textSize="14sp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rule Difficulty Slider Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡  Rule Difficulty"
                        android:textSize="12sp"
                        android:textColor="#F48FB1"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvDifficultyLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌱 Beginner — give me easy rules"
                        android:textSize="13sp"
                        android:textColor="#AD1457"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <SeekBar
                        android:id="@+id/sliderDifficulty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="4"
                        android:progress="0"
                        android:progressTint="#F48FB1"
                        android:thumbTint="#E91E63"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌱 Beginner"
                            android:textSize="11sp"
                            android:textColor="#BDBDBD"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏆 Pro"
                            android:textSize="11sp"
                            android:textColor="#BDBDBD"
                            android:gravity="end"/>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- About You Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌸  About You"
                        android:textSize="12sp"
                        android:textColor="#F48FB1"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="14dp"/>

                    <!-- Hours per day -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️  Hours per day for your goal"
                        android:textSize="13sp"
                        android:textColor="#5D4037"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/hoursInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 1"
                        android:inputType="numberDecimal"
                        android:padding="12dp"
                        android:background="@drawable/input_bg"
                        android:textColor="#5D4037"
                        android:textColorHint="#BDBDBD"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp"/>

                    <!-- Age range -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎂  Age Range"
                        android:textSize="13sp"
                        android:textColor="#5D4037"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/radioAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <RadioButton android:id="@+id/ageUnder18"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="&lt;18"
                            android:textSize="12sp" android:buttonTint="#F48FB1"/>
                        <RadioButton android:id="@+id/age18to25"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="18-25"
                            android:textSize="12sp" android:buttonTint="#F48FB1"/>
                        <RadioButton android:id="@+id/age26to35"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="26-35"
                            android:textSize="12sp" android:buttonTint="#F48FB1"/>
                        <RadioButton android:id="@+id/age36plus"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="36+"
                            android:textSize="12sp" android:buttonTint="#F48FB1"/>

                    </RadioGroup>

                    <!-- Toggle rows -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👶  Have kids?"
                            android:textSize="13sp" android:textColor="#5D4037"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchKids"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:theme="@style/PinkSwitch"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🐾  Have pets?"
                            android:textSize="13sp" android:textColor="#5D4037"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPets"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:theme="@style/PinkSwitch"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏙️  Living in a city?"
                            android:textSize="13sp" android:textColor="#5D4037"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchCity"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:theme="@style/PinkSwitch"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏠  Work from home?"
                            android:textSize="13sp" android:textColor="#5D4037"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchWFH"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:theme="@style/PinkSwitch"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Save Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#F48FB1">

                <TextView
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save Profile 🌸"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:background="?attr/selectableItemBackground"/>

            </androidx.cardview.widget.CardView>
            <!-- ── Rule History Dropdown ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Toggle header — tap to expand/collapse -->
                    <TextView
                        android:id="@+id/tvHistoryToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📖 Rule History  ▼"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#AD1457"
                        android:padding="18dp"
                        android:background="?attr/selectableItemBackground"/>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F8BBD0"/>

                    <!-- History cards container — hidden by default -->
                    <LinearLayout
                        android:id="@+id/historyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>