<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Rule text -->
    <TextView
        android:id="@+id/ruleText"
        android:text="@string/generate_rule_placeholder"
        android:textSize="20sp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Generate rule button -->
    <Button
        android:id="@+id/generateRule"
        android:text="@string/generate_rule_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Spacing -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

    <!-- Followed / Not followed buttons -->
    <Button
        android:id="@+id/btnFollowed"
        android:text="@string/btn_followed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnNotFollowed"
        android:text="@string/btn_not_followed"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>