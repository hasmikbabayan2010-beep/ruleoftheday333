<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Profile Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/avatar_circle_bg">
                    <TextView
                        android:id="@+id/tvInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="A"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Account"
                        android:textSize="12sp"
                        android:textColor="#F48FB1"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user@email.com"
                        android:textSize="14sp"
                        android:textColor="#5D4037"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Language Dropdown -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/headerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌍" android:textSize="20sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Language"
                        android:textSize="15sp" android:textColor="#5D4037"
                        android:fontFamily="sans-serif-medium" android:layout_marginStart="12dp"/>
                    <TextView android:id="@+id/tvLanguageValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🇬🇧 English" android:textSize="13sp"
                        android:textColor="#F48FB1" android:layout_marginEnd="8dp"/>
                    <ImageView android:id="@+id/arrowLanguage"
                        android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_down" app:tint="#F48FB1"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/contentLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingBottom="8dp">
                    <LinearLayout android:id="@+id/rowEnglish"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="52dp" android:paddingEnd="18dp"
                        android:background="@drawable/row_normal_bg">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="🇬🇧  English"
                            android:textSize="14sp" android:textColor="#5D4037"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_check_pink" android:tag="tick_en" android:visibility="gone"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowRussian"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="52dp" android:paddingEnd="18dp"
                        android:background="@drawable/row_normal_bg">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="🇷🇺  Russian"
                            android:textSize="14sp" android:textColor="#5D4037"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_check_pink" android:tag="tick_ru" android:visibility="gone"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowChinese"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="52dp" android:paddingEnd="18dp"
                        android:background="@drawable/row_normal_bg">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="🇨🇳  Chinese"
                            android:textSize="14sp" android:textColor="#5D4037"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_check_pink" android:tag="tick_zh" android:visibility="gone"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowArmenian"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="52dp" android:paddingEnd="18dp"
                        android:background="@drawable/row_normal_bg">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="🇦🇲  Հայերեն"
                            android:textSize="14sp" android:textColor="#5D4037"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_check_pink" android:tag="tick_hy" android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Theme Dropdown -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/headerTheme"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎨" android:textSize="20sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Theme"
                        android:textSize="15sp" android:textColor="#5D4037"
                        android:fontFamily="sans-serif-medium" android:layout_marginStart="12dp"/>
                    <TextView android:id="@+id/tvThemeValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌸 Pink" android:textSize="13sp"
                        android:textColor="#F48FB1" android:layout_marginEnd="8dp"/>
                    <ImageView android:id="@+id/arrowTheme"
                        android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_down" app:tint="#F48FB1"/>
                </LinearLayout>
                <!-- Theme rows built programmatically in SettingsFragment -->
                <LinearLayout
                    android:id="@+id/contentTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingBottom="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- My Current Rule -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎯  My Current Rule" android:textSize="13sp"
                    android:textColor="#F48FB1" android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvCurrentRule"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Loading..." android:textSize="16sp"
                    android:textColor="#5D4037" android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.3"/>
                <TextView android:id="@+id/tvEditRule"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✏️ Edit" android:textSize="12sp"
                    android:textColor="#CE93D8" android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground" android:padding="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sign Out -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:id="@+id/rowSignOut"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="?attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🚪" android:textSize="20sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Sign Out"
                    android:textSize="15sp" android:textColor="#E91E63"
                    android:fontFamily="sans-serif-medium" android:layout_marginStart="12dp"/>
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_down" android:rotation="-90"
                    app:tint="#F48FB1"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Danger Zone -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFF8F8">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚠️  Danger Zone" android:textSize="13sp"
                    android:textColor="#E57373" android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp"/>
                <LinearLayout
                    android:id="@+id/rowResetCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/row_danger_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="🗑️  Reset calendar data"
                        android:textSize="14sp" android:textColor="#C62828"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_down" android:rotation="-90"
                        app:tint="#E57373"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>